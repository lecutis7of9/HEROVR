#include <winres.h>

1 ICON "spidy.ico"

// Spidy's print, the house style of its videos and README (main.cpp loads them; SIL Open Font License,
// docs/licenses).
FONT_BODY RCDATA "fonts/Barlow-Medium.ttf"
FONT_SEMIBOLD RCDATA "fonts/Barlow-SemiBold.ttf"
FONT_LABEL RCDATA "fonts/BarlowCondensed-Bold.ttf"
FONT_KICKER RCDATA "fonts/BarlowCondensed-SemiBold.ttf"
FONT_DISPLAY RCDATA "fonts/BarlowCondensed-BlackItalic.ttf"
FONT_NARRATION RCDATA "fonts/ComicNeue-BoldItalic.ttf"

// The controls on Quest 3 controllers, the README's picture (the Controls tab).
PICTURE_CONTROLS RCDATA "../../docs/images/readme/controls-quest3.jpg"

VS_VERSION_INFO VERSIONINFO
FILEVERSION SPIDY_VERSION_NUMBERS
PRODUCTVERSION SPIDY_VERSION_NUMBERS
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Ilya Mezerowsky"
            VALUE "FileDescription", "Spidy VR launcher"
            VALUE "FileVersion", SPIDY_VERSION
            VALUE "InternalName", "spidy_launcher"
            VALUE "LegalCopyright", "Copyright 2026 Ilya Mezerowsky"
            VALUE "OriginalFilename", "Spidy Launcher.exe"
            VALUE "ProductName", "SM2 VR (port of SpidyVR) - VR for Marvel's Spider-Man 2"
            VALUE "ProductVersion", SPIDY_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
